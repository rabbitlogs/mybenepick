---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSenseList from '../../components/AdSenseList.astro';
import { CATEGORY_NAMES_LONG, LEGACY_CATEGORY_REDIRECTS } from '../../data/categories.js';

// ⚠️ BaseLayout.astro의 ADSENSE_ENABLED와 함께 켜고 끄세요.
const ADSENSE_ENABLED = false;

const POSTS_PER_PAGE = 8;
const CATEGORIES = ['youth', 'parenting', 'living', 'self-employed'];

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { LEGACY_CATEGORY_REDIRECTS } = await import('../../data/categories.js');
  const allPosts = await getCollection('blog');
  const cats = ['youth', 'parenting', 'living', 'self-employed'];

  const paths = [];
  for (const cat of cats) {
    const posts = allPosts
      .filter((p) => p.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    // 현재 글 수(카테고리당 4~9건)에서는 한 페이지에 전부 담는다.
    // 카테고리가 더 커지면 이 라우트를 [...cat].astro로 바꿔 페이지네이션을 되살릴 것.
    paths.push({
      params: { cat },
      props: { cat, posts, total: posts.length, redirectTo: null },
    });
  }

  // 2026-07 개편으로 사라진 구 slug는 원래 주소를 유지한 채 새 카테고리로 넘긴다.
  for (const [oldSlug, newSlug] of Object.entries(LEGACY_CATEGORY_REDIRECTS)) {
    paths.push({
      params: { cat: oldSlug },
      props: { cat: newSlug, posts: [], total: 0, redirectTo: `/category/${newSlug}` },
    });
  }

  return paths;
}

const { cat, posts, total, redirectTo } = Astro.props;
const catName = CATEGORY_NAMES_LONG;
const catDesc = {
  youth: [
    '청년의 취업·창업·자산형성을 돕는 지원금과 제도를 모았어요.',
    '국민취업지원제도, 내일배움카드, 청년미래적금 같은 정보를 다룹니다.',
  ],
  parenting: [
    '육아와 출산 관련 지원금과 제도를 모았어요.',
    '육아휴직급여, 아동수당, 돌봄서비스 등을 정리합니다.',
  ],
  living: [
    '주거·노후·생활비까지, 일상에 바로 쓰이는 지원제도를 모았어요.',
    '주거급여와 청약, 국민연금, 에너지바우처 같은 정보를 다룹니다.',
  ],
  'self-employed': [
    '소상공인·자영업자를 위한 지원금과 제도를 모았어요.',
    '경영안정 바우처, 정책자금 대환대출, 노란우산공제 등을 다룹니다.',
  ],
};

const target = redirectTo;
---

{target ? (
  <html lang="ko">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>이동합니다 — 혜택PICK!!</title>
      <meta name="robots" content="noindex, follow" />
      <link rel="canonical" href={`https://mybenepick.com${target}`} />
      <meta http-equiv="refresh" content={`0; url=${target}`} />
      <script is:inline set:html={`location.replace(${JSON.stringify(target)});`} />
    </head>
    <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center; color: #334155;">
      <p>카테고리가 «{catName[cat]}»으로 통합됐어요.</p>
      <p><a href={target}>자동으로 이동하지 않으면 여기를 눌러주세요</a></p>
    </body>
  </html>
) : (
<BaseLayout title={`${catName[cat]} — 혜택PICK!!`} description={catDesc[cat].join(' ')} showAds={true}>
  <section class="cat-list" style="padding-top: 1.2rem;">
    <nav class="breadcrumb" aria-label="이동 경로">
      <a href="/">홈</a> / <span class="active">{catName[cat]}</span>
    </nav>
    <div class="cat-list-header">
      <div>
        <h1 style="font-size: 2rem; margin: 0 0 0.6rem;">{catName[cat]}</h1>
        <p style="font-size: 0.98rem; color: var(--muted); line-height: 1.7; margin: 0;">
          {catDesc[cat].map((line, i) => (<>{i > 0 && <><br class="cat-desc-br" /> </>}{line}</>))}
        </p>
      </div>
      <span class="total-badge">총 {total}건</span>
    </div>
    <style>
      @media (max-width: 640px) { .cat-desc-br { display: none; } }
    </style>

    {posts.length === 0 && (
      <p style="color: var(--muted); padding: 2rem 0;">아직 등록된 글이 없어요. 곧 채워질 예정이에요.</p>
    )}

    <div>
      {posts.map((post, i) => (
        <>
          <PostCard
            href={`/blog/${post.id.replace('.md', '')}`}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            pubDate={post.data.pubDate}
            metric={post.data.metric}
            deadline={post.data.deadline}
            contentTags={post.data.contentTags}
          />
          {i === 3 && ADSENSE_ENABLED && <AdSenseList />}
        </>
      ))}
      {posts.length > 0 && ADSENSE_ENABLED && <AdSenseList />}
    </div>

  </section>

  {ADSENSE_ENABLED && (
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slots = document.querySelectorAll('.cat-list .ad-slot');
      slots.forEach((slot) => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}

        const ins = slot.querySelector('ins.adsbygoogle');
        if (!ins) return;

        let tries = 0;
        const checker = setInterval(() => {
          tries++;
          const status = ins.getAttribute('data-ad-status');
          const iframe = ins.querySelector('iframe');

          if (status === 'unfilled') {
            slot.remove();
            clearInterval(checker);
          } else if (iframe && iframe.offsetHeight > 0) {
            clearInterval(checker);
          } else if (tries >= 12) {
            slot.remove();
            clearInterval(checker);
          }
        }, 250);
      });
    });
  </script>
  )}

  <style>
    .breadcrumb { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.9rem; }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--primary); }
    .breadcrumb .active { color: var(--primary); font-weight: 600; }
    .cat-list-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 1rem; margin-bottom: 1.4rem; padding-bottom: 1.4rem; flex-wrap: wrap;
      border-bottom: 1px solid var(--line);
    }
    .total-badge {
      flex-shrink: 0; font-size: 0.85rem; font-weight: 700; color: var(--accent);
      background: var(--color-bg-soft); padding: 0.4rem 0.9rem; border-radius: 999px;
    }

    .pagination { display: flex; justify-content: center; align-items: center; gap: 0.4rem; margin-top: 2rem; }
    .page-num, .page-arrow {
      display: inline-flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border-radius: 8px;
      font-size: 0.85rem; font-weight: 600; color: var(--muted);
      text-decoration: none; border: 1px solid transparent;
    }
    .page-num:hover, .page-arrow:hover { border-color: var(--line); color: var(--primary); }
    .page-num.active { background: var(--primary); color: #fff; }
    .page-arrow { border-color: var(--line); font-size: 1.1rem; }
  </style>
</BaseLayout>
)}
